// FSM-платформа — базовая схема Milestone 1.
// Покрывает: пользователей/роли, бригады, клиентов, объекты, заявки
// с полным жизненным циклом статусов и историей изменений.
// Остальные модули ТЗ (склад, оборудование, чек-листы, AI и т.д.)
// добавляются следующими миграциями поверх этой основы.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // руководитель / полный доступ
  DISPATCHER // диспетчер
  MANAGER // руководитель бригады
  WORKER // полевой сотрудник
}

enum WorkOrderStatus {
  NEW // Новая
  ASSIGNED // Назначена
  EN_ROUTE // В пути
  ARRIVED // Прибыл
  IN_PROGRESS // В работе
  WAITING_MATERIALS // Ожидает материалы
  WAITING_APPROVAL // Требуется согласование
  COMPLETED // Завершена
  CLOSED // Закрыта
  CANCELLED // Отменена
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(WORKER)
  specialization String?
  status       String   @default("offline") // online | offline (позже: on_task и т.д.)
  rating       Float?
  lat              Float?
  lng              Float?
  locationUpdatedAt DateTime?
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  createdAt    DateTime @default(now())

  assignedOrders WorkOrder[]      @relation("AssignedTo")
  createdOrders  WorkOrder[]      @relation("CreatedBy")
  historyEvents  WorkOrderEvent[]
  attachments    Attachment[]
  checklistSubmissions ChecklistSubmission[]
  stockMovements StockMovement[]
  interactions   Interaction[]
  collections    CollectionRecord[]
  accessLogs     DeviceAccessLog[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  leaderId  String?
  createdAt DateTime @default(now())

  members    User[]
  workOrders WorkOrder[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  sites      Site[]
  workOrders WorkOrder[]
  contracts  Contract[]
  interactions Interaction[]
}

/// Объект обслуживания (адрес/точка) — магазин, банкомат, стройплощадка и т.д.
model Site {
  id        String   @id @default(cuid())
  name      String
  address   String?
  lat       Float?
  lng       Float?
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  workOrders WorkOrder[]
  equipment  Equipment[]
}

model WorkOrder {
  id          String          @id @default(cuid())
  number      String          @unique
  status      WorkOrderStatus @default(NEW)
  priority    String          @default("normal") // normal | urgent (аварийный вызов)
  title       String
  description String?
  slaDueAt    DateTime?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  siteId   String?
  site     Site?   @relation(fields: [siteId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  teamId       String?
  team         Team?   @relation(fields: [teamId], references: [id])
  equipmentId  String?
  equipment    Equipment? @relation(fields: [equipmentId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      WorkOrderEvent[]
  attachments Attachment[]
  checklistSubmissions ChecklistSubmission[]
  stockMovements StockMovement[]
}

/// История изменений заявки (для карточки "история изменений")
model WorkOrderEvent {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  type        String // status_change | comment | assignment | ...
  message     String
  createdAt   DateTime  @default(now())
}

model Attachment {
  id            String    @id @default(cuid())
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])
  url           String
  kind          String // photo | document | video
  lat           Float?
  lng           Float?
  uploadedById  String?
  uploadedBy    User?     @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime  @default(now())
}

/// Шаблон динамического чек-листа под тип работ (мерч, банкоматы,
/// клининг, монтаж и т.д. — своя структура полей под каждый).
model ChecklistTemplate {
  id        String   @id @default(cuid())
  name      String
  fields    Json // [{id,label,type:'checkbox'|'text'|'number',required}]
  createdAt DateTime @default(now())

  submissions ChecklistSubmission[]
}

model ChecklistSubmission {
  id          String            @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder         @relation(fields: [workOrderId], references: [id])
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id])
  answers     Json // {fieldId: значение}
  score       Float?
  submittedById String?
  submittedBy   User?           @relation(fields: [submittedById], references: [id])
  createdAt   DateTime          @default(now())
}

/// Оборудование, закреплённое за объектом (банкомат, картомат, станок и т.д.)
model Equipment {
  id             String    @id @default(cuid())
  name           String
  model          String?
  serialNumber   String?
  status         String    @default("operational") // operational | broken | maintenance
  deviceType     String    @default("other") // atm | cardomat | other — для спецмодуля банкоматов
  cassetteLevelPercent Float? // заполненность кассет, только для atm/cardomat
  siteId         String?
  site           Site?     @relation(fields: [siteId], references: [id])
  warrantyUntil  DateTime?
  lastServiceAt  DateTime?
  nextServiceAt  DateTime?
  lastCollectionAt DateTime? // последняя инкассация
  notes          String?
  createdAt      DateTime  @default(now())

  workOrders WorkOrder[]
  collections CollectionRecord[]
  accessLogs  DeviceAccessLog[]
}

/// Инкассация — изъятие/пересчёт наличности из устройства
model CollectionRecord {
  id            String    @id @default(cuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  amount        Float?
  performedById String?
  performedBy   User?     @relation(fields: [performedById], references: [id])
  notes         String?
  createdAt     DateTime  @default(now())
}

/// Контроль открытия/закрытия устройства (сервисная дверца, сейф)
model DeviceAccessLog {
  id            String    @id @default(cuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  action        String // open | close
  performedById String?
  performedBy   User?     @relation(fields: [performedById], references: [id])
  notes         String?
  createdAt     DateTime  @default(now())
}

/// Материалы / запчасти / расходники на складе. quantity — текущий остаток,
/// пересчитывается при каждом движении (приход/выдача/возврат/списание).
model InventoryItem {
  id          String   @id @default(cuid())
  name        String
  sku         String?
  unit        String   @default("шт")
  quantity    Float    @default(0)
  minQuantity Float?
  createdAt   DateTime @default(now())

  movements StockMovement[]
}

model StockMovement {
  id          String        @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  type        String // receipt | issue | return | writeoff
  quantity    Float
  workOrderId String?
  workOrder   WorkOrder?    @relation(fields: [workOrderId], references: [id])
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  comment     String?
  createdAt   DateTime      @default(now())
}

model Contract {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  number    String
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
}

/// Свободная запись о контакте с клиентом (звонок, встреча, письмо) —
/// "история взаимодействий" из ТЗ.
model Interaction {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  type      String // call | meeting | email | note
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

/// Заготовка под AI-модуль (архитектура из ТЗ): единая точка, куда
/// в будущем будут складываться результаты анализа моделью — сейчас
/// /ai/analyze возвращает заглушку с этой же структурой, без реального
/// подключения модели (нет ключа/провайдера).
model AiInsight {
  id         String   @id @default(cuid())
  type       String // photo_analysis | anomaly | forecast | recommendation | search
  targetType String? // workOrder | equipment | user | ...
  targetId   String?
  summary    String
  payload    Json?
  createdAt  DateTime @default(now())
}
