DATABASE_URL="postgresql://user:password@localhost:5432/fsm?schema=public"
JWT_SECRET="сгенерируйте_длинную_случайную_строку"
PORT=4000

# Уведомления в Telegram (необязательно). Токен — от @BotFather, никогда не коммитить.
TELEGRAM_BOT_TOKEN=

# Уведомления на email (необязательно). Без этих переменных канал просто
# выключен, остальное работает как обычно. SMTP_PORT=465 включает TLS
# автоматически, иначе используется STARTTLS. SMTP_FROM необязателен —
# по умолчанию берётся SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Corpi <noreply@thecorpi.com>"

# Список разрешённых origin через запятую (необязательно). Если не задать —
# CORS открыт для всех, как раньше. В проде укажите реальные домены
# фронтендов, например: https://thecorpi.com,https://app.thecorpi.com
CORS_ORIGINS=
