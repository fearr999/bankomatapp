DATABASE_URL="postgresql://user:password@localhost:5432/fsm?schema=public"
JWT_SECRET="сгенерируйте_длинную_случайную_строку"
PORT=4000

# Уведомления в Telegram (необязательно). Токен — от @BotFather, никогда не коммитить.
TELEGRAM_BOT_TOKEN=

# Support-бот (необязательно, отдельный от TELEGRAM_BOT_TOKEN выше) — на него
# ведёт кнопка "Написать в Telegram" на экране истёкшего пробного периода и
# баннер "осталось N дней". Отвечает клиентам сам (/start — приветствие,
# любое сообщение — подтверждение получения). Токен — от @BotFather,
# никогда не коммитить.
TELEGRAM_SUPPORT_BOT_TOKEN=
# chat_id, куда пересылать входящие сообщения от клиентов (необязательно —
# без него бот всё равно отвечает клиенту, просто ничего не дублирует вам).
# Получить: напишите что-нибудь своему support-боту, затем откройте
# https://api.telegram.org/bot<TELEGRAM_SUPPORT_BOT_TOKEN>/getUpdates
# в браузере — там будет "chat":{"id": ...}.
TELEGRAM_SUPPORT_ADMIN_CHAT_ID=

# Уведомления на email (необязательно). Без этих переменных канал просто
# выключен, остальное работает как обычно. SMTP_PORT=465 включает TLS
# автоматически, иначе используется STARTTLS. SMTP_FROM необязателен —
# по умолчанию берётся SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Corpi <noreply@thecorpi.com>"

# Нативный push в мобильном приложении через Firebase Cloud Messaging
# (необязательно). Содержимое JSON-файла сервисного аккаунта Firebase
# (Project settings → Service accounts → Generate new private key) —
# в одну строку, никогда не коммитить. Без него канал просто выключен,
# в браузере/PWA вместо него по-прежнему работает Web Push.
FIREBASE_SERVICE_ACCOUNT=

# Список разрешённых origin через запятую (необязательно). Если не задать —
# CORS открыт для всех, как раньше. В проде укажите реальные домены
# фронтендов, например: https://thecorpi.com,https://app.thecorpi.com
CORS_ORIGINS=
